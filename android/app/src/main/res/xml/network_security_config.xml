<?xml version="1.0" encoding="utf-8"?>
<!-- Allow cleartext HTTP to loopback hosts and the dev machine on the LAN.
     adb-reverse (http://localhost:5000) is flaky on this MIUI device, so the
     app can also hit the Mac's Wi-Fi IP (192.168.1.7:5000) directly. -->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">localhost</domain>
        <domain includeSubdomains="true">127.0.0.1</domain>
        <domain includeSubdomains="true">10.0.2.2</domain>
        <domain includeSubdomains="true">192.168.1.7</domain>
    </domain-config>
</network-security-config>
