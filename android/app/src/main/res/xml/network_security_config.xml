<?xml version="1.0" encoding="utf-8"?>
<!-- Allow cleartext HTTP only to loopback hosts. The app talks to the local
     backend over the USB adb-reverse tunnel at http://localhost:5000.
     15.252.29.112 is the plain-HTTP dev API server — remove it once that host
     serves HTTPS, since cleartext traffic to it is fully interceptable. This
     must be kept in sync with VITE_API_BASE_URL in .env: a host that is not
     listed here is blocked by Android before the request ever leaves. -->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">localhost</domain>
        <domain includeSubdomains="true">127.0.0.1</domain>
        <domain includeSubdomains="true">10.0.2.2</domain>
        <domain includeSubdomains="false">15.252.29.112</domain>
    </domain-config>
</network-security-config>
